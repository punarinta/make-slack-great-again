#pragma once
namespace AppCredentials {
inline constexpr const char *clientId     = "@MSGA_CLIENT_ID@";
inline constexpr const char *clientSecret = "@MSGA_CLIENT_SECRET@";
inline constexpr const char *xapp         = "@MSGA_XAPP@";
// Microsoft Teams (Microsoft Graph) public-client app registration. Multi-tenant,
// no secret (Auth Code + PKCE). teamsTenant is the authority segment for the
// initial sign-in ("organizations" = any work/school tenant; per-workspace refresh
// uses the workspace's own tenant id).
inline constexpr const char *teamsClientId = "@MSGA_TEAMS_CLIENT_ID@";
inline constexpr int         version      = @MSGA_VERSION@;
inline constexpr const char *buildTimestamp = "@MSGA_BUILD_TIMESTAMP@";
}
