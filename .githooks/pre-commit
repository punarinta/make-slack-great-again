#!/usr/bin/env bash
# Pre-commit: clang-format check on staged C++ files.
# Clazy requires a full build pass — run it manually:
#   cmake -DMSGA_CLAZY=ON -B build -S . && cmake --build build --target clazy
set -euo pipefail

if ! command -v clang-format &>/dev/null; then
    echo "pre-commit: clang-format not found — skipping format check"
    echo "  Install via: sudo apt install clang-format  (or brew install clang-format)"
    exit 0
fi

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(cpp|h)$' \
    | grep -v '^make-slack-great-again/' \
    || true)

[[ ${#files[@]} -eq 0 ]] && exit 0

bad=()
for f in "${files[@]}"; do
    if ! clang-format --dry-run --Werror "$f" 2>/dev/null; then
        bad+=("$f")
    fi
done

if [[ ${#bad[@]} -gt 0 ]]; then
    echo "pre-commit: clang-format violations in:"
    printf "  %s\n" "${bad[@]}"
    echo ""
    echo "Run:  clang-format -i ${bad[*]}"
    exit 1
fi
